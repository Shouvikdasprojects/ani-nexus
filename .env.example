# 🌐 AniNexus Server Port
PORT=5055

# 🗄️ MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aninexus?retryWrites=true&w=majority

# 🎬 TMDB API Key (For 4K Backdrops, Logos, Episode Stills & Legal OTT Links)
TMDB_API_KEY=your_tmdb_api_key_here

# 🔑 Official MyAnimeList (MAL) 5-Key Pool (Round-Robin Rotator)
MAL_KEY_1=your_mal_client_id_1
MAL_KEY_2=your_mal_client_id_2
MAL_KEY_3=your_mal_client_id_3
MAL_KEY_4=your_mal_client_id_4
MAL_KEY_5=your_mal_client_id_5
