# 🌐 AniNexus Server Port
PORT=5055

# 🏛️ Distributed Multi-Vault High-Availability Database Engine
# Vault 1: Primary Core Media Archive (Franchises, Characters, Staff, Awards)
MONGODB_PRIMARY_URI=mongodb+srv://username:password@aninexusapidb2.mongodb.net/aninexus?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@aninexusapidb2.mongodb.net/aninexus?retryWrites=true&w=majority

# Vault 1B: Primary Spillover Archive (Auto-spillover when Vault 1 reaches 450MB)
MONGODB_VAULT1B_URI=mongodb+srv://username:password@vault1b-cluster.mongodb.net/aninexus?retryWrites=true&w=majority

# Vault 2: Reading Media Archive (Manga, Manhwa, Manhua, Light Novels)
MONGODB_OVERFLOW_URI=mongodb+srv://username:password@cluster0.mongodb.net/aninexus?retryWrites=true&w=majority
MONGODB_SECONDARY_URI=mongodb+srv://username:password@cluster0.mongodb.net/aninexus?retryWrites=true&w=majority

# Vault 2B: Reading Spillover Archive (Auto-spillover when Vault 2 reaches 450MB)
MONGODB_VAULT2B_URI=mongodb+srv://username:password@vault2b-cluster.mongodb.net/aninexus?retryWrites=true&w=majority

# Vault 3: Dedicated Real-Time & News/Schedule Hub (RSS Feeds, 60-Day TTL, Airing Calendar)
MONGODB_REALTIME_URI=mongodb+srv://username:password@realtime-cluster.mongodb.net/aninexus?retryWrites=true&w=majority

# 🎬 TMDB API Key (For 4K Backdrops, Logos, Episode Stills & Legal OTT Links)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_bearer_token

# 🔑 Official MyAnimeList (MAL) 5-Key Pool (Round-Robin Rotator)
MAL_KEY_1=your_mal_client_id_1
MAL_KEY_2=your_mal_client_id_2
MAL_KEY_3=your_mal_client_id_3
MAL_KEY_4=your_mal_client_id_4
MAL_KEY_5=your_mal_client_id_5
